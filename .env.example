DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

POSTGRES_DB=isyara
POSTGRES_USER=isyara
POSTGRES_PASSWORD=isyara
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://isyara:isyara@localhost:5432/isyara

# Optional: when set, Django calls FastAPI instead of the local mock client.
ASSESSMENT_SERVICE_URL=http://localhost:8001
FASTAPI_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
BISINDO_YOLO_MODEL_PATH=models/bisindo_words.pt
BISINDO_ALPHABET_MODEL_PATH=models/bisindo_yolo11.pt
BISINDO_YOLO_CONFIDENCE_THRESHOLD=0.75
BISINDO_YOLO_IMAGE_SIZE=640
BISINDO_YOLO_MIN_BOX_AREA=0.015
BISINDO_YOLO_MAX_BOX_AREA=0.45
BISINDO_YOLO_EDGE_MARGIN=0.01
BISINDO_STABILIZATION_WINDOW=5
BISINDO_STABILIZATION_MATCHES=4
BISINDO_RELEASE_WINDOW=6
WHISPER_MODEL=base

# Optional Google OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production hardening toggles.
ACCOUNT_EMAIL_VERIFICATION=none
SECURE_SSL_REDIRECT=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SECURE_HSTS_SECONDS=0
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=1
